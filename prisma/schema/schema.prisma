datasource db {
  provider = "postgresql" // Ajuste para seu banco (postgresql, mysql, sqlite, etc.)
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int               @id @default(autoincrement())
  email         String            @unique
  password      String
  name          String
  fichaTormenta FichaTormenta20[]
  fichaGeral    fichaGeral[]
  campanhas     Campanha[]
  campanhaId    Int?
}

model FichaTormenta20 {
  id Int @id @default(autoincrement())

  // Identidade
  nomeJogador    String
  nomePersonagem String
  raca           String
  classe         String
  origem         String
  nivel          Int     @default(1)
  divindade      String?
  pvCurrent      Int
  pmCurrent      Int
  descricao      String?
  tamanho        String  @default("Medio")

  // Atributos
  for Int
  int Int
  des Int
  con Int
  sab Int
  car Int

  // Valores Derivados
  pvMax        Int
  pmMax        Int
  defesa       Defesa?
  deslocamento Int
  tibao        Int
  // Relações
  jogador      User    @relation(fields: [jogadorId], references: [id], onDelete: Cascade)
  jogadorId    Int

  items       Item[]
  armas       Arma[]
  protecoes   Protecao[]
  gerais      Geral[]
  magias      Magia[]
  habilidades Habilidade[]
  pericias    Pericia[]
  campanha    Campanha[]
  historico   Historico[]
  campanhaId  Int?
}

model Defesa {
  id            Int             @id @default(autoincrement())
  outros        Int             @default(0)
  atributos     String          @default("Des")
  fichaTormenta FichaTormenta20 @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  fichaId       Int             @unique
}

model Pericia {
  id              Int             @id @default(autoincrement())
  atributo        String
  nome            String
  metadeDoNivel   Int
  treino          Int
  outros          Int
  fichaTormenta20 FichaTormenta20 @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  fichaId         Int
}

model Arma {
  id            Int     @id @default(autoincrement())
  nome          String // Corrigido de Int para String
  preco         Int
  dadoDeDano    String // Ex: "1d6", "2d8" costumam ser strings
  alcance       String
  peso          Float
  tipoDano      String
  tipoArma      String
  critico       Int
  multiplicador Int
  atributo      String
  descricao     String?
  pericia       String
  equiped       Boolean @default(false)

  modificacoes    modificacao[]
  fichaTormenta20 FichaTormenta20 @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  fichaId         Int
}

model modificacao {
  id        String @id @default(uuid())
  descricao String
  arma      Arma?  @relation(fields: [armaId], references: [id])
  armaId    Int?
}

model Historico {
  id            Int              @id @default(autoincrement())
  value         String
  fichaTormenta FichaTormenta20? @relation(fields: [fichaId], references: [id])
  fichaId       Int?
}

model Protecao {
  id           Int     @id @default(autoincrement())
  nomeProtecao String
  preco        Int
  bonus        Int
  penalidade   Int
  peso         Float
  tipoProtecao String
  equipada     Boolean @default(false)
  descricao    String?

  fichaTormenta FichaTormenta20 @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  fichaId       Int
}

model Geral {
  id            Int    @id @default(autoincrement())
  tipoItemGeral String
  preco         Int

  fichaTormenta FichaTormenta20 @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  fichaId       Int
}

model Habilidade {
  id            Int             @id @default(autoincrement())
  nome          String
  descricao     String
  gastoPe       Int?
  classe        String
  fichaTormenta FichaTormenta20 @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  fichaId       Int
}

model Magia {
  id            Int             @id @default(autoincrement())
  execucao      String
  alcance       String
  alvo          String
  duracao       String
  truque        String?
  gastoPe       Int
  descricao     String
  nome          String
  tipoMagia     String
  Circulo       String
  fichaTormenta FichaTormenta20 @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  fichaId       Int
}

model Item {
  id            Int              @id @default(autoincrement())
  nome          String
  peso          Float
  descricao     String
  fichaTormenta FichaTormenta20? @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  fichaId       Int?
}

model Campanha {
  id               Int               @id @default(autoincrement())
  players          User[]
  playerMestreId   Int
  nomeCampanha     String
  fichasTormenta   FichaTormenta20[]
  fichasGerais     fichaGeral[]
  chaveLink        String
  historicoRolagem String[]
}

model Atributo {
  id            Int    @id @default(autoincrement())
  name          String
  atributoValue Int    @default(10)
  modificador   Int    @default(0)
  fichaId       Int?
}
